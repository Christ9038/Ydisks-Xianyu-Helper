# syntax=docker/dockerfile:1.7

FROM --platform=$BUILDPLATFORM node:22-trixie AS frontend
WORKDIR /src/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM --platform=$BUILDPLATFORM node:22-trixie AS playwright-driver
RUN npm install -g playwright@1.57.0 \
    && mkdir -p /ms-playwright-go/package \
    && cp -a /usr/local/lib/node_modules/playwright/. /ms-playwright-go/package/ \
    && if [ -d /usr/local/lib/node_modules/playwright-core ]; then \
        mkdir -p /ms-playwright-go/package/node_modules \
        && cp -a /usr/local/lib/node_modules/playwright-core /ms-playwright-go/package/node_modules/playwright-core; \
    fi

FROM --platform=$BUILDPLATFORM golang:1.26-trixie AS backend
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /src/internal/webui/static ./internal/webui/static
RUN CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags="-s -w" -o /out/xianyu-server ./cmd/server \
    && CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags="-s -w" -o /out/xianyu-dbseed ./cmd/dbseed \
    && CGO_ENABLED=0 GOOS="$TARGETOS" GOARCH="$TARGETARCH" go build -trimpath -ldflags="-s -w" -o /out/xianyu-dbverify ./cmd/dbverify

FROM debian:13-slim AS runtime
ENV TZ=Asia/Shanghai
ENV BROWSER_HEADLESS=true
ENV PLAYWRIGHT_DRIVER_PATH=/ms-playwright-go
ENV PLAYWRIGHT_NODEJS_PATH=/usr/bin/node
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        chromium \
        curl \
        fonts-liberation \
        fonts-noto-cjk \
        nodejs \
        tzdata \
    && update-ca-certificates --fresh \
    && test -s "$SSL_CERT_FILE" \
    && grep -q -- '-----BEGIN CERTIFICATE-----' "$SSL_CERT_FILE" \
    && test -x "$PLAYWRIGHT_NODEJS_PATH" \
    && test -x "$PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH" \
    && rm -rf /var/lib/apt/lists/*
COPY --from=backend /out/xianyu-server /app/xianyu-server
COPY --from=backend /out/xianyu-dbseed /app/xianyu-dbseed
COPY --from=backend /out/xianyu-dbverify /app/xianyu-dbverify
COPY --from=playwright-driver /ms-playwright-go /ms-playwright-go
RUN mkdir -p /app/data /app/browser_data
EXPOSE 8080
CMD ["/app/xianyu-server", "-addr", ":8080"]

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key><string>com.ydisks.xianyu-helper.tray</string>
	<key>ProgramArguments</key><array><string>__TRAY__</string></array>
	<key>RunAtLoad</key><true/>
	<key>StandardOutPath</key><string>__LOG_DIR__/tray.log</string>
	<key>StandardErrorPath</key><string>__LOG_DIR__/tray.log</string>
	<!-- 托盘允许用户退出；服务端 LaunchAgent 单独负责 KeepAlive。 -->
	<key>KeepAlive</key><false/>
</dict>
</plist>

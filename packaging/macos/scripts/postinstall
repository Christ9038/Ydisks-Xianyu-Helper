#!/bin/sh
set -eu

INSTALL_LOG="/var/log/ydisks-xianyu-helper-install.log"
exec >>"$INSTALL_LOG" 2>&1
trap 'exit_code=$?; printf "[%s] postinstall exit code: %s\\n" "$(date -u "+%Y-%m-%dT%H:%M:%SZ")" "$exit_code"' EXIT

printf '\n[%s] postinstall start; uid=%s; user=%s; args=%s\n' \
  "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$(id -u)" "$(id -un)" "$*"
set -x

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
APP=""
for app_path in \
  "/Applications/Ydisks闲鱼助手/Ydisks闲鱼助手.app" \
  "/Applications/Ydisks Xianyu Helper.app" \
  "/Applications/Ydisks Xianyu Helper.localized/Ydisks Xianyu Helper.app"
do
  if [ -f "$app_path/Contents/Info.plist" ]; then
    APP="$app_path"
    break
  fi
done
if [ -z "$APP" ]; then
	echo "找不到已安装的 Ydisks闲鱼助手.app，无法继续注册服务。"
  exit 1
fi

SERVER="$APP/Contents/Helpers/xianyu-server"
TRAY="$APP/Contents/MacOS/Ydisks闲鱼助手"
RUNTIME_ROOT="$APP/Contents/Resources/playwright-runtime"
CONSOLE_USER="$(stat -f '%Su' /dev/console)"

if [ "$CONSOLE_USER" = "root" ] || [ -z "$CONSOLE_USER" ]; then
  echo "没有登录用户，跳过 LaunchAgent；登录后请重新打开应用。"
  exit 0
fi

UID_VALUE="$(id -u "$CONSOLE_USER")"
HOME_DIR="$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory | awk '{print $2}')"
DATA_DIR="$HOME_DIR/Library/Application Support/YdisksXianyuHelper"
LOG_DIR="$HOME_DIR/Library/Logs/YdisksXianyuHelper"
AGENT_DIR="$HOME_DIR/Library/LaunchAgents"

RUNTIME_ARCH=""
for candidate_arch in arm64 amd64; do
  if [ -d "$RUNTIME_ROOT/$candidate_arch/playwright-driver" ] && [ -d "$RUNTIME_ROOT/$candidate_arch/playwright-browsers" ]; then
    RUNTIME_ARCH="$candidate_arch"
    break
  fi
done
if [ -z "$RUNTIME_ARCH" ]; then
  echo "安装包缺少完整的 Playwright runtime：$RUNTIME_ROOT"
  exit 1
fi
echo "使用 $RUNTIME_ARCH 架构的 Playwright runtime。"

mkdir -p "$DATA_DIR" "$LOG_DIR" "$AGENT_DIR"
chown -R "$CONSOLE_USER" "$DATA_DIR" "$LOG_DIR"
chown "$CONSOLE_USER" "$AGENT_DIR"

escape_sed() {
  printf '%s' "$1" | sed 's/[&|]/\\&/g'
}

SERVER_ESCAPED="$(escape_sed "$SERVER")"
TRAY_ESCAPED="$(escape_sed "$TRAY")"
DATA_ESCAPED="$(escape_sed "$DATA_DIR")"
LOG_ESCAPED="$(escape_sed "$LOG_DIR")"
RUNTIME_ROOT_ESCAPED="$(escape_sed "$RUNTIME_ROOT")"

SERVER_LABEL="com.ydisks.xianyu-helper.server"
TRAY_LABEL="com.ydisks.xianyu-helper.tray"
server_plist="$AGENT_DIR/$SERVER_LABEL.plist"
tray_plist="$AGENT_DIR/$TRAY_LABEL.plist"
sed -e "s|__SERVER__|$SERVER_ESCAPED|g" \
    -e "s|__DATA_DIR__|$DATA_ESCAPED|g" \
    -e "s|__LOG_DIR__|$LOG_ESCAPED|g" \
    -e "s|__RUNTIME_ROOT__|$RUNTIME_ROOT_ESCAPED|g" \
    "$APP/Contents/Resources/com.ydisks.xianyu-helper.server.plist.template" > "$server_plist"
sed -e "s|__TRAY__|$TRAY_ESCAPED|g" \
	-e "s|__LOG_DIR__|$LOG_ESCAPED|g" \
    "$APP/Contents/Resources/com.ydisks.xianyu-helper.tray.plist.template" > "$tray_plist"
chown "$CONSOLE_USER" "$server_plist" "$tray_plist"
chmod 0644 "$server_plist" "$tray_plist"

launchctl bootout "gui/$UID_VALUE/$SERVER_LABEL" >/dev/null 2>&1 || true
launchctl bootout "gui/$UID_VALUE/$TRAY_LABEL" >/dev/null 2>&1 || true

# 旧版本的托盘曾经可能在 bootout 后脱离 launchd 继续存活。它仍然占用
# 菜单栏并使用旧的控制逻辑，会让升级后的第二次启动看起来像启动失败。
# 这里只按当前应用的绝对路径清理旧托盘，不影响其它程序。
STALE_TRAY_PIDS="$(ps -axo pid=,command= | awk -v target="$TRAY" '$2 == target {print $1}')"
for stale_pid in $STALE_TRAY_PIDS; do
  if [ "$stale_pid" != "$$" ] && [ -n "$stale_pid" ]; then
    kill -TERM "$stale_pid" >/dev/null 2>&1 || true
  fi
done
if [ -n "$STALE_TRAY_PIDS" ]; then
  sleep 1
  for stale_pid in $STALE_TRAY_PIDS; do
    if [ "$stale_pid" != "$$" ] && kill -0 "$stale_pid" >/dev/null 2>&1; then
      kill -KILL "$stale_pid" >/dev/null 2>&1 || true
    fi
  done
fi

# 清理早期版本使用的个人域名标识，避免升级后新旧 LaunchAgent 同时运行。
LEGACY_SERVER_LABEL="com.christ.ydisks-xianyu-helper.server"
LEGACY_TRAY_LABEL="com.christ.ydisks-xianyu-helper.tray"
launchctl bootout "gui/$UID_VALUE/$LEGACY_SERVER_LABEL" >/dev/null 2>&1 || true
launchctl bootout "gui/$UID_VALUE/$LEGACY_TRAY_LABEL" >/dev/null 2>&1 || true
rm -f "$AGENT_DIR/$LEGACY_SERVER_LABEL.plist" "$AGENT_DIR/$LEGACY_TRAY_LABEL.plist"

launchctl bootstrap "gui/$UID_VALUE" "$server_plist"
launchctl bootstrap "gui/$UID_VALUE" "$tray_plist"
# bootstrap 会根据 RunAtLoad 自动启动两个 LaunchAgent。这里不能再调用
# kickstart -k：它会给刚由 bootstrap 启动的托盘发送 SIGTERM，托盘会按
# 正常退出流程停止服务，导致安装完成后第一次启动就被自己关掉。

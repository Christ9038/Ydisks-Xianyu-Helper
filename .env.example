# 复制为 .env 后再填写。不要提交包含真实密钥的 .env。
COMPOSE_PROJECT_NAME=ydisks-xianyu-helper

# PostgreSQL 17
POSTGRES_IMAGE=postgres:17-trixie
POSTGRES_DB=xianyu
POSTGRES_USER=xianyu
POSTGRES_PASSWORD=请替换为高强度数据库密码
# 密码含有特殊字符时，必须先进行 URL 编码。
DATABASE_URL=postgres://xianyu:请替换为URL编码后的数据库密码@postgres:5432/xianyu?sslmode=disable

# 应用：默认 compose.yml 仅拉取 GHCR 镜像，不会在服务器上构建源码。
XIANYU_IMAGE=ghcr.io/christ9038/ydisks-xianyu-helper:latest
XIANYU_DATA_KEY=请替换为稳定且足够长的随机密钥
XIANYU_BIND_ADDRESS=0.0.0.0
XIANYU_HTTP_PORT=59188
XIANYU_UPLOAD_DIR=/app/data/uploads
TZ=Asia/Shanghai
LOG_LEVEL=info
LOG_FORMAT=json
BROWSER_HEADLESS=true

# 首次 docker compose up -d 时自动创建 admin；后续重启不会重置密码。
XIANYU_ADMIN_PASSWORD=请替换为管理员密码
